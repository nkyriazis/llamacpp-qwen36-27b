#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

[[ -f .env ]] || cp .env.example .env
set -a; source .env; set +a

required=(
  docker-compose.yml
  llama-cpp.Dockerfile
  .env.example
  "models/${LLAMA_MODEL#/models/}"
  "models/${LLAMA_MMPROJ#/models/}"
)

missing=0
for path in "${required[@]}"; do
  if [[ ! -e "$path" ]]; then
    echo "missing: $path" >&2
    missing=1
  fi
done

if [[ "$missing" -ne 0 ]]; then
  exit 1
fi

if grep -RInE '/home/kyriazis/work/local_llm|\.{2}/local_llm' docker-compose.yml .env .env.example llama-cpp.Dockerfile >/tmp/self_contained_hits.txt; then
  echo "found external path references:" >&2
  cat /tmp/self_contained_hits.txt >&2
  exit 1
fi

echo "self-contained check passed"
