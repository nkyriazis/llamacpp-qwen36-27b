# Build: llama.cpp commit (pinned; verified with Qwen3.8 + MTP) and GPU arch (RTX 5090 = 120a)
LLAMA_CPP_REF=cd74ef6274e55b1591373637cc35324af000a5ee
LLAMA_CUDA_ARCH=120a

# Model. Files live under ./models/<Model>/ (mounted at /models).
LLAMA_MODEL=/models/Qwen3.8-27B/Qwen3.8-27B-UD-Q4_K_XL.gguf
LLAMA_MMPROJ=/models/Qwen3.8-27B/mmproj-F16.gguf
LLAMA_ALIAS=qwen3.8-27b
# Previous model (also has an MTP head):
#LLAMA_MODEL=/models/Qwen3.6-27B/Qwen3.6-27B-Q4_K_M.gguf
#LLAMA_MMPROJ=/models/Qwen3.6-27B/mmproj-F16.gguf
#LLAMA_ALIAS=qwen3.6-27b

# Context + KV cache. Measured on the RTX 5090 (32 GB, ~2.2 GB used by the desktop; 1 slot, add ~0.8 GB for 3):
#   UD-Q4_K_XL, 200K ctx, q8_0 KV, ub 1024, vision on GPU -> ~30.3 GB peak with a 203K-token prompt
#   224K (229376) also loads (~31.1 GB idle) but leaves ~1.5 GB slack.
LLAMA_CTX_SIZE=204800
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_CACHE_TYPE_V=q8_0
LLAMA_BATCH=2048
LLAMA_UBATCH=512
# ubatch 512 vs 1024: -0.5 GB VRAM, prefill -2% (3019 vs 3073 tok/s on 30K tokens). With 1024 and 3 slots the
# server hit CUDA OOM on its first decode once the desktop grew to ~3 GB (llama.cpp allocates part of its
# memory lazily). Measured after first use: 28.7 GB for llama.cpp with 3 slots, 28.1 GB with 2.
# Host-RAM prompt cache (MiB). A full 200K-token state is ~10 GB, so keep this well above that
# to let long sessions / sub-agents swap in and out of the slot without re-prefilling.
LLAMA_CACHE_RAM=32768

# Concurrency. 3 slots over one unified KV pool (the 200K context is shared by all slots; each slot
# may use up to the full context). Measured with 3 concurrent Claude Code agents: 63 s vs 222 s on a
# single slot, where agents evict each other's cache (96% of prompt tokens re-processed vs 9.7%).
# Single-stream speed is unchanged, MTP included. 4 slots idle at 31.6 GB (too tight on 32 GB).
# Serial use: LLAMA_PARALLEL=1 (one agent at a time, each can use the full context, ~0.8 GB less VRAM).
# claude-code/claude-qwen reads the slot count from the server and configures Claude Code to match.
LLAMA_PARALLEL=3
LLAMA_KV_UNIFIED=1
LLAMA_SPEC_TYPE=draft-mtp
LLAMA_SPEC_DRAFT_N_MAX=3

# Prompt-cache checkpoints (hybrid model: state can only be restored at saved checkpoints).
# llama.cpp places them at user-message starts and just before the prompt end; defaults work well.
LLAMA_CTX_CHECKPOINTS=32
LLAMA_CHECKPOINT_MIN_STEP=8192
# 3 = info, 4 = trace (shows checkpoint save/restore and prompt-cache decisions)
LLAMA_LOG_VERBOSITY=3

# Reasoning ("thinking"). Tested 2026-09-25: 27/27 loop-prone prompts finish cleanly with on + medium.
# The template's default effort is xhigh, which is coherent but spends 10-24K tokens on coding tasks;
# medium keeps it to ~1-4K. Clients can override per request with
#   "chat_template_kwargs": {"reasoning_effort": "low"|"medium"|"xhigh"}
# The budget is a safety cap: thinking is closed with the budget message and the model answers.
# For LLAMA_REASONING=off, switch sampling to TEMP=0.7 TOP_P=0.8 PRESENCE_PENALTY=1.5.
LLAMA_REASONING=on
LLAMA_REASONING_EFFORT=medium
LLAMA_REASONING_BUDGET=16384

# Default sampling (Qwen-recommended for thinking mode). Clients can override per request.
LLAMA_TEMP=1.0
LLAMA_TOP_P=0.95
LLAMA_TOP_K=20
LLAMA_MIN_P=0.0
LLAMA_PRESENCE_PENALTY=0.0
