#!/usr/bin/env bash
# Claude Code with local subagents served by this stack's llama.cpp. Only this process's environment
# is changed: nothing is written to ~/.claude or to the project. Router state/logs stay in ./.state.
#
#   claude-code/claude-qwen [claude args...]          hybrid: normal (Anthropic) main session, plus
#                                                     the agents in agents.json on the local model
#   claude-code/claude-qwen --local [claude args...]  everything on the local model
#
# The Claude side is derived from the running server (GET /props), so it follows .env changes:
#   model name  = the served alias (LLAMA_ALIAS)
#   parallelism = the server's slot count (LLAMA_PARALLEL); 1 slot => agents are told to run one at a time
#   context     = server context / slots (the KV pool is shared), used as the window Claude Code assumes
#
# Env overrides:
#   CLAUDE_QWEN_LLAMA          llama.cpp base URL                    (default http://127.0.0.1:8080)
#   CLAUDE_QWEN_ROUTER_PORT    router port                           (default 8098)
#   CLAUDE_QWEN_CONTEXT        window Claude Code assumes for the local model
#   CLAUDE_QWEN_STRICT_SERIAL  1 = with a 1-slot server, also cap Claude Code to one subagent at a time
#                              (CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=1; this applies to ALL subagents)
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
state="$here/.state"
port="${CLAUDE_QWEN_ROUTER_PORT:-8098}"
llama="${CLAUDE_QWEN_LLAMA:-http://127.0.0.1:8080}"

mode=hybrid
if [[ "${1:-}" == "--local" ]]; then
  mode=local
  shift
fi

props="$(curl -fsS --max-time 5 "$llama/props" 2>/dev/null)" || {
  echo "claude-qwen: llama.cpp is not reachable at $llama (start it with ./scripts/up)" >&2
  exit 1
}
read -r alias slots n_ctx < <(python3 -c '
import json, sys
p = json.load(sys.stdin)
print(p["model_alias"], p.get("total_slots", 1), p["default_generation_settings"]["n_ctx"])' <<<"$props")
context="${CLAUDE_QWEN_CONTEXT:-$((n_ctx / slots))}"

# Router: (re)start it if it is not running or was started for a different model.
mkdir -p "$state"
pidfile="$state/router-$port.pid" cfgfile="$state/router-$port.model"
running=""
if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
  running="$(cat "$cfgfile" 2>/dev/null || true)"
  if [[ "$running" != "$alias" ]]; then
    kill "$(cat "$pidfile")" 2>/dev/null || true
    running=""
    sleep 0.3
  fi
fi
if [[ -z "$running" ]]; then
  alias_re="$(python3 -c 'import re,sys; print("^" + re.escape(sys.argv[1]) + "$")' "$alias")"
  ROUTER_PORT="$port" LOCAL_UPSTREAM="$llama" LOCAL_MODEL_RE="$alias_re" ROUTER_LOG="$state/router.jsonl" \
    nohup python3 "$here/router.py" >"$state/router-$port.out" 2>&1 &
  echo $! >"$pidfile"
  echo "$alias" >"$cfgfile"
  for _ in $(seq 50); do
    [[ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 1 "http://127.0.0.1:$port/" || true)" != "000" ]] && break
    sleep 0.1
  done
  if ! kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    rm -f "$pidfile" "$cfgfile"
    echo "claude-qwen: router failed to start on port $port (is another process using it?):" >&2
    cat "$state/router-$port.out" >&2
    exit 1
  fi
fi

# Agent definitions for this server: model = served alias, concurrency guidance = slot count.
agents="$(python3 - "$here/agents.json" "$alias" "$slots" <<'PY'
import json, sys
path, alias, slots = sys.argv[1], sys.argv[2], int(sys.argv[3])
agents = json.load(open(path))
if slots > 1:
    note = f" Up to {slots} can run in parallel at full speed; more than that queue."
else:
    note = (" Run at most one at a time: never launch several of these agents in parallel or in the"
            " background; wait for one to report before starting the next.")
for spec in agents.values():
    spec["model"] = alias
    spec["description"] = spec["description"].rstrip() + note
print(json.dumps(agents))
PY
)"

export ANTHROPIC_BASE_URL="http://127.0.0.1:$port"
# Only applies to model IDs Claude Code does not recognise, i.e. the local model.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$context"
if [[ "$slots" -eq 1 && "${CLAUDE_QWEN_STRICT_SERIAL:-0}" == 1 ]]; then
  export CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=1
fi

if [[ "$mode" == local ]]; then
  export ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-local}"   # stripped by the router; skips login
  export ANTHROPIC_MODEL="$alias"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$alias" ANTHROPIC_DEFAULT_SONNET_MODEL="$alias" ANTHROPIC_DEFAULT_HAIKU_MODEL="$alias"
  export CLAUDE_CODE_SUBAGENT_MODEL="$alias"
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
fi

exec claude --agents "$agents" "$@"
